<<script>>
(function () {
    function createBackgroundVideo() {
        let video = document.getElementById("bgVideo");

        if (!video) {
            video = document.createElement("video");
            video.id = "bgVideo";
            video.autoplay = true;
            video.muted = true;
            video.loop = true;
            video.playsInline = true;
            video.style.display = "none";
            
            document.body.prepend(video);
        }

        return video;
    }

    window.setBackgroundVideo = function (videoFile) {
    	// Don't let the passage tag system overwrite the video
    	// while the agent is actively controlling playback.
    	if (window.agentVideoActive) return;

        const video = createBackgroundVideo();

        if (!videoFile) {
            video.pause();
            video.removeAttribute("src");
            video.style.display = "none";
            video.load();
            return;
        }

        const newSrc = "/media/live/" + videoFile;

        if (video.getAttribute("src") !== newSrc) {
            video.onerror = function () {
                console.log("Video nije pronađen:", newSrc);
                video.pause();
                video.removeAttribute("src");
                video.style.display = "none";
                video.load();
            };

            video.setAttribute("src", newSrc);
            video.style.display = "block";
            video.style.opacity = "1";
            video.load();

            video.play().catch(function (error) {
                console.log("Video autoplay problem:", error);
            });
        }
    };

    window.updateBackgroundVideoByTags = function () {
        const tagString = document.body.getAttribute("data-tags") || "";
        const tags = tagString.split(" ").filter(Boolean);

        let video = null;

        if (tags.includes("intro") && tags.includes("title")) {
            video = null;
        }
        else if (tags.includes("intro") && tags.includes("backstory")) {
            video = "Intro_Backstory.mp4";
        }
        else if (tags.includes("intro") && tags.includes("earth")) {
            video = "Intro_Earth.mp4";
        }
        else if (tags.includes("intro") && tags.includes("arrival")) {
            video = "Intro_Arrival.mp4";
        }
        else if (tags.includes("intro") && tags.includes("riots")) {
            video = "Intro_Riots.mp4";
        }
        else if (tags.includes("intro") && tags.includes("exchange")) {
            video = "Intro_Exchange.mp4";
        }
        else if (tags.includes("intro") && tags.includes("kidnapping")) {
            video = "Intro_Kidnapping.mp4";
        }
        else if (tags.includes("intro")) {
            video = "Intro_Backstory.mp4";
        }
        else if (tags.includes("waking") && tags.includes("wait")) {
            video = "Waking_Wait.mp4";
        }
        else if (tags.includes("waking")) {
            video = "Waking.mp4";
        }
        else if (tags.includes("room1") && tags.includes("exit")) {
            video = "FirstRoom.mp4";
        }
        else if (tags.includes("room1") && tags.includes("device")) {
            video = "Room_Device.mp4";
        }
        else if (tags.includes("room1")) {
            video = "Room.mp4";
        }
        else if (tags.includes("contact") && tags.includes("device")) {
            video = "Contact_Device.mp4";
        }
        else if (tags.includes("contact")) {
            video = "Contact.mp4";
        }

        else if (tags.includes("hallway") && tags.includes("exception")) {
             video = "Hallway_Exception.mp4";
        }
        else if (tags.includes("hallway") && tags.includes("watcher")) {
            video = "Hallway_Watcher.mp4";
        }
        else if (tags.includes("hallway") && tags.includes("dark")) {
            video = "Hallway_Dark.mp4";
        }
        else if (tags.includes("hallway") && (tags.includes("control-door") || tags.includes("controldoor"))) {
            video = "Hallway_ControlDoor.mp4";
