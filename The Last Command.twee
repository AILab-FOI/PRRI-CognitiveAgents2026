            video = "FusionCore_Exception.mp4";
        }
        else if (tags.includes("core") && tags.includes("narrator")) {
            video = "FusionCore_Narrator.mp4";
        }
        else if (tags.includes("core") && tags.includes("burn")) {
            video = "FusionCore_Burn.mp4";
        }
        else if (tags.includes("core")) {
            video = "FusionCore.mp4";
        }

        else if (tags.includes("ending") && tags.includes("compliance")) {
            video = "Ending_Compliance.mp4";
        }
        else if (tags.includes("ending") && tags.includes("aggression")) {
