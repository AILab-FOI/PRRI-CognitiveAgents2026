		}
        else if (tags.includes("control") && tags.includes("final")) {
            video = "ControlRoom_Final.mp4";
        }
        else if (tags.includes("control")) {
            video = "ControlRoom.mp4";
        }

        else if (tags.includes("core") && tags.includes("brightburn")) {
            video = "FusionCore_BrightBurn.mp4";
        }
        else if (tags.includes("core") && tags.includes("overload")) {
