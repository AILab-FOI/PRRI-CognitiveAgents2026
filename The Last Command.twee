/*Textbox*/
.textbox {
    position: fixed;
    bottom: 70px;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    background-color: rgba(0, 0, 0, 0.75);
    border: 2px solid #ffffff;
    border-radius: 8px;
    padding: 35px 30px 20px 30px; 
    min-height: 120px;
    color: #ffffff;
    font-size: 1.2em;
    z-index: 10;
}

/*Speaker*/
.speaker {
    position: absolute;
    top: -20px;
    left: 20px;
    background-color: #222222;
    border: 2px solid #ffffff;
    border-radius: 5px;
    padding: 5px 20px;
    font-weight: bold;
    font-size: 1.1em;
    color: #ffeb3b;
    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.6);
}

/*Choice*/
.choice {
    position: fixed;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    gap: 15px;
    z-index: 100;
}

.choice a {
    background-color: rgba(0, 0, 0, 0.9);
    color: #ffffff;
    border: 1px solid #aaaaaa;
    padding: 12px 40px;
    text-align: center;
    border-radius: 5px;
    font-size: 1.1em;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
}

.choice a:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: #ffffff;
}

/*Bottom menu*/
#ui-bar {
    position: fixed !important;
    top: auto !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 45px !important;
    background-color: rgba(0, 0, 0, 0.9) !important;
    border-right: none !important;
    border-top: 1px solid #555 !important;
    display: flex !important;
    flex-direction: row !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 0 !important;
    z-index: 200 !important;
    transition: none !important; 
    margin: 0 !important;
}

#ui-bar-toggle, #title, #story-caption { 
    display: none !important; 
}

/*Back/forward arrows*/
#ui-bar-tray {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    border: none !important;
    padding: 0 15px !important;
    width: auto !important;
}

#ui-bar-body {
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    height: 100% !important;
    overflow: visible !important;
    background: transparent !important;
}

/*Save/Restart*/
#menu {
    display: flex !important;
    flex-direction: row !important;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

#menu-core, #menu-story {
    display: flex !important;
    flex-direction: row !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    list-style: none !important;
}

#menu li { 
    border: none !important; 
    margin: 0 !important;
}

#menu li a { 
    border: none !important; 
    padding: 0 20px !important; 
    text-transform: uppercase !important; 
    font-size: 0.9em !important; 
    color: #ccc !important;
    background-color: transparent !important;
    display: inline-block !important;
}

#menu li a:hover { 
    color: #fff !important; 
    background-color: rgba(255, 255, 255, 0.1) !important; 
}

/* =========================
   LIVE BACKGROUND EFFECTS
   ========================= */

html, body {
    overflow-x: hidden;
}

/* lagani puls ambijenta */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
        radial-gradient(circle at 20% 30%, rgba(0, 255, 255, 0.08), transparent 25%),
        radial-gradient(circle at 80% 60%, rgba(255, 170, 50, 0.06), transparent 28%);
    animation: ambientPulse 7s ease-in-out infinite;
}

/* sitne lebdeće čestice */
body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image:
        radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.30), transparent),
        radial-gradient(1px 1px at 30% 75%, rgba(0,255,255,0.28), transparent),
        radial-gradient(1px 1px at 55% 40%, rgba(255,255,255,0.20), transparent),
        radial-gradient(1px 1px at 75% 15%, rgba(0,255,255,0.25), transparent),
        radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.20), transparent);
    animation: particleDrift 14s linear infinite;
    opacity: 0.7;
}

@keyframes ambientPulse {
    0% {
        opacity: 0.4;
        transform: scale(1);
    }
    50% {
        opacity: 0.85;
        transform: scale(1.03);
    }
    100% {
        opacity: 0.4;
        transform: scale(1);
    }
}

@keyframes particleDrift {
    0% {
        transform: translateY(0px);
        opacity: 0.45;
    }
    50% {
        opacity: 0.8;
    }
    100% {
        transform: translateY(-20px);
        opacity: 0.45;
    }
}

/* =========================
   LIVE VIDEO BACKGROUND
   ========================= */

#bgVideo {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    object-fit: contain;
    background: black;
    z-index: 1;
    pointer-events: none;
    opacity: 1;
}

/* Twine tekst i izbori moraju biti iznad videa */
#story {
    position: relative;
    z-index: 2;
}

/* Ako koristiš sidebar / UI, i on neka bude iznad */
#ui-bar {
    position: relative;
    z-index: 3;
}

/* =========================================================
   UI MERGE — KOLEGIN MAIN.CSS + INDEX_NJEGOVO.HTML
   Baza je ostala "The Last Command Moje.twee".
   Ovaj blok dodaje kolegine UI promjene u StoryStylesheet,
   ali NE koristi background shorthand na bodyju kako ne bi pregazio
   postojeće slike po tagovima i live video sustav.
   ========================================================= */

html,
body {
    color: #e6f1ff !important;
    font-family: 'Segoe UI', sans-serif !important;
    margin: 0;
    padding: 0;
    min-height: 100vh;
}

#story,
#passages,
.passage {
    background: transparent !important;
    color: #e6f1ff !important;
}

#story {
    max-width: 1100px !important;
    margin: 0 auto !important;
    padding: 40px !important;
}

#passages {
    max-width: 1000px;
    margin: auto;
    padding: 2rem;
}

.passage {
    animation: fadeIn 0.4s ease;
}

/* Kolegine dorade tekstualnog okvira, ali bez brisanja postojeće pozicije. */
.textbox,
.dialogue,
.speech-box,
.narrator,
#textbox {
    background: rgba(10, 16, 28, 0.96) !important;
    border: 2px solid #00b4ff !important;
    border-radius: 20px !important;
    box-shadow: 0 0 35px rgba(0, 180, 255, 0.35) !important;
    color: #e6f1ff !important;
}

.textbox {
    padding: 35px !important;
    margin-top: 30px !important;
    max-width: 1200px !important;
    animation: fadeIn 0.4s ease;
}

.textbox span {
    color: #e6f1ff !important;
    font-size: 1.3rem !important;
    line-height: 1.8 !important;
}

/* Kolegina dorada oznake govornika. */
.speaker {
    background: linear-gradient(135deg, #00b4ff, #0066ff) !important;
    color: white !important;
    display: inline-block !important;
    padding: 12px 24px !important;
    border-radius: 12px !important;
    font-weight: bold !important;
    font-size: 1.2rem !important;
    margin-bottom: 20px !important;
    box-shadow: 0 0 20px rgba(0, 180, 255, 0.5) !important;
    border: none !important;
}

/* Kolegina najvažnija UI promjena: izbori više nisu fiksirani u sredini ekrana,
   nego se slažu normalno unutar dijaloškog okvira. */
.choice {
    position: static !important;
    top: auto !important;
    left: auto !important;
    transform: none !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 15px !important;
    width: 100% !important;
    margin-top: 24px !important;
    z-index: 100 !important;
}

.choice a {
    display: block !important;
    width: 100% !important;
    box-sizing: border-box !important;
    background: linear-gradient(135deg, rgba(8, 18, 32, 0.95), rgba(3, 8, 18, 0.95)) !important;
    color: #e6f1ff !important;
    border: 1px solid rgba(0, 180, 255, 0.75) !important;
    border-radius: 14px !important;
    padding: 20px 26px !important;
    text-align: center !important;
    font-size: 1.15em !important;
    font-weight: 600 !important;
    letter-spacing: 0.3px !important;
    text-decoration: none !important;
    box-shadow: inset 0 0 12px rgba(0, 180, 255, 0.08), 0 0 10px rgba(0, 180, 255, 0.12) !important;
    transition: all 0.25s ease !important;
}

.choice a:hover {
    background: linear-gradient(135deg, rgba(0, 180, 255, 0.25), rgba(0, 94, 255, 0.18)) !important;
    border-color: #00d5ff !important;
    color: #ffffff !important;
    transform: translateY(-3px) scale(1.01) !important;
    box-shadow: 0 0 22px rgba(0, 180, 255, 0.65), inset 0 0 18px rgba(0, 180, 255, 0.12) !important;
}

button,
.link-internal,
.macro-link {
    color: #ffffff !important;
    background: linear-gradient(135deg, #00b4ff, #005eff) !important;
    border: none !important;
    border-radius: 10px !important;
    padding: 10px 16px !important;
    text-decoration: none !important;
    transition: 0.25s ease !important;
    display: inline-block;
    margin-top: 10px;
    font-weight: 600;
}

button:hover,
.link-internal:hover,
.macro-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 14px rgba(0, 180, 255, 0.8) !important;
}

textarea,
input,
select {
    background: #111827 !important;
    color: white !important;
    border: 1px solid #3b82f6 !important;
    border-radius: 10px !important;
    padding: 10px !important;
}

#ui-bar,
#ui-dialog,
#ui-overlay {
    background: rgba(5, 10, 18, 0.96) !important;
    border-color: #00b4ff !important;
}

#ui-bar {
    box-shadow: 0 -4px 20px rgba(0, 180, 255, 0.25) !important;
}

#ui-bar button,
#ui-bar a,
#menu li a {
    background: transparent !important;
    color: #e6f1ff !important;
    border: 1px solid #2f4f70 !important;
    border-radius: 8px !important;
}

#ui-bar button:hover,
#ui-bar a:hover,
#menu li a:hover {
    background: rgba(0, 180, 255, 0.18) !important;
    box-shadow: 0 0 10px rgba(0, 180, 255, 0.4) !important;
}

.agent-frame {
    border: 2px solid #00b4ff !important;
    border-radius: 14px !important;
    box-shadow: 0 0 25px rgba(0, 180, 255, 0.35) !important;
    background: #0f172a !important;
}

.hud {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.55);
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 20px;
    border: 1px solid #00b4ff;
    font-size: 14px;
}

h1,
h2,
h3 {
    color: #8bdcff !important;
    text-shadow: 0 0 8px rgba(0, 180, 255, 0.35);
}

fieldset {
    background: rgba(10, 16, 28, 0.92) !important;
    border: 2px solid #00b4ff !important;
    border-radius: 18px !important;
    box-shadow: 0 0 30px rgba(0, 180, 255, 0.4) !important;
    padding: 32px !important;
}

legend {
    background: rgba(10, 16, 28, 1) !important;
    color: #8bdcff !important;
    border: 2px solid #00b4ff !important;
    border-radius: 10px !important;
    padding: 10px 22px !important;
    text-shadow: 0 0 10px rgba(0, 180, 255, 0.8) !important;
}

fieldset p {
    color: #e6f1ff !important;
    font-size: 1.15rem !important;
    line-height: 1.7 !important;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 768px) {
    #story {
        padding: 16px !important;
    }

    #passages {
        padding: 1rem;
    }

    .textbox,
    .dialogue,
    .speech-box,
    .narrator,
    #textbox {
        padding: 16px !important;
        width: calc(100vw - 32px) !important;
        max-width: none !important;
    }

    button,
    .link-internal,
    .macro-link {
        width: 100%;
        text-align: center;
    }

    .hud {
        flex-direction: column;
        gap: 8px;
    }
}

/* =========================================================
   END UI MERGE — KOLEGIN MAIN.CSS + INDEX_NJEGOVO.HTML
   ========================================================= */

/* ---------- TITLE SCREEN ---------- */

body[data-tags~="intro"][data-tags~="title"] {
    background-image: url('/media/TitleScreen.png'), url('/media/Intro_Backstory.png');
}

.title-screen {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    padding: 40px;
    pointer-events: none;
}

.title-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: #00d5ff;
    opacity: 0.85;
    margin-bottom: 18px;
    text-shadow: 0 0 14px rgba(0, 213, 255, 0.65);
}

.title-screen h1 {
    margin: 0;
    font-size: clamp(4rem, 10vw, 9rem);
    line-height: 0.9;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #eaf7ff;
    text-shadow:
        0 0 12px rgba(0, 213, 255, 0.8),
        0 0 36px rgba(0, 120, 255, 0.65),
        0 0 90px rgba(0, 0, 0, 0.9);
}

.title-subtitle {
    margin-top: 22px;
    max-width: 760px;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(230, 241, 255, 0.82);
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.85);
}

.title-rule {
    width: min(520px, 70vw);
    height: 1px;
    margin-top: 30px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(0, 213, 255, 0.85),
        rgba(255, 180, 80, 0.75),
        transparent
    );
    box-shadow: 0 0 18px rgba(0, 213, 255, 0.45);
}

.title-choice {
    pointer-events: auto;
    width: auto !important;
    max-width: 340px !important;
    margin-top: 42px !important;
    align-items: center !important;
}

.title-choice a {
    min-width: 220px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
}

/* =========================================================
   FINAL UI FIXES — PAVO MERGE, BACKGROUND SAFE
   Ovo ide NA KRAJ StoryStylesheeta.
   Ne dira background-image pravila za slike po tagovima.
   ========================================================= */

/* ---------- REMOVE PAGE / BACKGROUND SCROLLBAR ---------- */

html,
body {
    margin: 0 !important;
    padding: 0 !important;

    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;

    overflow: hidden !important;

    color: #e6f4ff !important;
    font-family: "Segoe UI", sans-serif !important;

    background-color: #000 !important;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
}

/* ---------- STORY LAYOUT FIX ---------- */

#story {
    position: relative !important;
    z-index: 2 !important;

    width: 100% !important;
    max-width: 1200px !important;

    height: 100vh !important;
    min-height: 0 !important;

    margin: 0 auto !important;
    padding: 30px !important;

    overflow: hidden !important;

    transform: none !important;
    box-sizing: border-box !important;
}

#passages {
    max-width: 950px !important;
    height: 100% !important;
    min-height: 0 !important;

    margin: 0 auto !important;
    padding: 1rem !important;

    position: relative !important;

    overflow: hidden !important;

    transform: none !important;
    box-sizing: border-box !important;
}

.passage {
    background: transparent !important;
    color: #e6f4ff !important;

    min-height: 0 !important;

    animation: none !important;
    transform: none !important;

    overflow: hidden !important;
}

/* ---------- VIDEO BACKGROUND FIX ---------- */

/* ---------- VIDEO BACKGROUND FIX ---------- */

#bgVideo {
    position: fixed !important;
    inset: 0 !important;

    width: 100vw !important;
    height: 100vh !important;

    object-fit: cover !important;
    object-position: center center !important;

    background: #000 !important;

    z-index: 0 !important;
    pointer-events: none !important;
    opacity: 1 !important;
}

/* Twine tekst mora biti iznad videa */
#story,
#passages,
.passage {
    position: relative !important;
    z-index: 2 !important;
}

/* Donji UI bar iznad svega */
#ui-bar {
    z-index: 2000 !important;
}

/* Textbox iznad videa */
.textbox {
    z-index: 1000 !important;
}

/* ---------- TEXTBOX FIX ---------- */

.textbox {
    position: fixed !important;

    left: 50% !important;
    right: auto !important;
    top: auto !important;
    bottom: 70px !important;

    transform: translateX(-50%) !important;

    width: fit-content !important;
    min-width: 360px !important;
    max-width: 88vw !important;

    min-height: 120px !important;

    margin: 0 auto !important;
    padding: 34px 42px 28px 42px !important;

    box-sizing: border-box !important;

    background: rgba(5, 12, 24, 0.88) !important;

    border: 1px solid rgba(0, 220, 255, 0.45) !important;
    border-radius: 22px !important;

    box-shadow:
        0 0 35px rgba(0, 180, 255, 0.22),
        inset 0 0 24px rgba(0, 180, 255, 0.05) !important;

    backdrop-filter: blur(7px) !important;

    text-align: center !important;

    z-index: 1000 !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;

    animation: none !important;
}

/* ---------- SPEAKER FIX ---------- */

.speaker {
    position: absolute !important;

    top: -32px !important;
    left: 50% !important;
    right: auto !important;

    transform: translateX(-50%) !important;

    display: inline-block !important;

    width: auto !important;
    min-width: 140px !important;
    max-width: max-content !important;

    margin: 0 !important;
    padding: 10px 26px !important;

    background: linear-gradient(135deg, #00b4ff, #005eff) !important;

    color: white !important;

    border: none !important;
    border-radius: 12px !important;

    text-align: center !important;
    white-space: nowrap !important;

    font-size: 1rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em !important;

    box-shadow: 0 0 18px rgba(0, 180, 255, 0.45) !important;

    box-sizing: border-box !important;

    z-index: 1002 !important;
}

/* ---------- TEXT FIX ---------- */

.textbox,
.textbox p,
.passage,
.passage p {
    color: #e6f4ff !important;

    font-size: 1.12rem !important;
    line-height: 1.75 !important;

    text-shadow: 0 0 6px rgba(0, 0, 0, 0.5) !important;
}

.textbox p,
.textbox div:not(.speaker),
.textbox span:not(.speaker) {
    width: auto !important;
    max-width: 900px !important;

    margin-left: auto !important;
    margin-right: auto !important;

    text-align: center !important;
}

/* ---------- CHOICE CONTAINER FIX ---------- */

.choice {
    position: relative !important;

    left: auto !important;
    right: auto !important;
    top: auto !important;
    bottom: auto !important;

    transform: none !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;

    gap: 12px !important;

    width: fit-content !important;
    max-width: 100% !important;

    margin: 24px auto 0 auto !important;

    padding: 8px 10px 8px 10px !important;

    z-index: 1001 !important;

    max-height: 260px !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;

    box-sizing: border-box !important;

    scrollbar-width: thin !important;
    scrollbar-color: rgba(0, 220, 255, 0.75) rgba(5, 12, 24, 0.65) !important;
}

/* ---------- CHOICE SCROLLBAR ---------- */

.choice::-webkit-scrollbar {
    width: 8px !important;
}

.choice::-webkit-scrollbar-track {
    background: rgba(5, 12, 24, 0.65) !important;
    border-radius: 999px !important;
}

.choice::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #00dfff, #0066ff) !important;
    border-radius: 999px !important;
    box-shadow: 0 0 10px rgba(0, 220, 255, 0.65) !important;
}

.choice::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #6ff6ff, #0088ff) !important;
}

/* ---------- CHOICE BUTTON FIX ---------- */

.choice a,
.choice a.link-internal,
.choice .macro-link,
#passages .passage a.link-internal,
#passages .passage a.macro-link,
#passages .passage button {
    display: block !important;

    width: 280px !important;
    max-width: 420px !important;

    margin: 0 auto !important;
    padding: 12px 28px !important;

    background: linear-gradient(135deg, #00b4ff, #0066ff) !important;
    color: white !important;

    border: 2px solid rgba(139, 220, 255, 0.75) !important;
    border-radius: 14px !important;

    text-align: center !important;
    text-decoration: none !important;

    font-size: 1rem !important;
    font-weight: 700 !important;

    box-sizing: border-box !important;
    box-shadow: 0 0 18px rgba(0, 180, 255, 0.45) !important;

    cursor: pointer !important;

    transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        filter 0.15s ease !important;
}

/* ---------- CHOICE BUTTON HOVER ---------- */

.choice a:hover,
.choice a.link-internal:hover,
.choice .macro-link:hover,
#passages .passage a.link-internal:hover,
#passages .passage a.macro-link:hover,
#passages .passage button:hover {
    transform: translateY(-2px) !important;

    box-shadow:
        0 0 26px rgba(0, 220, 255, 0.65),
        inset 0 0 18px rgba(0, 220, 255, 0.10) !important;

    filter: brightness(1.08) !important;
}

/* ---------- UI BAR FIX ---------- */

#ui-bar {
    position: fixed !important;

    top: auto !important;
    bottom: 0 !important;
    left: 0 !important;

    width: 100% !important;
    height: 48px !important;

    background: rgba(4, 10, 18, 0.96) !important;

    border-right: none !important;
    border-top: 1px solid rgba(0, 220, 255, 0.35) !important;

    box-shadow: 0 -4px 20px rgba(0, 180, 255, 0.18) !important;

    z-index: 2000 !important;
}

#ui-bar-toggle,
#title,
#story-caption {
    display: none !important;
}

/* ---------- MOBILE FIX ---------- */

@media (max-width: 768px) {

    #story {
        padding: 14px !important;
    }

    #passages {
        padding: 0.5rem !important;
    }

    .textbox {
        min-width: 0 !important;

        width: calc(100vw - 32px) !important;
        max-width: calc(100vw - 32px) !important;

        bottom: 55px !important;

        padding: 32px 22px 24px 22px !important;

        border-radius: 16px !important;
    }

    .speaker {
        min-width: 120px !important;

        padding: 9px 20px !important;

        font-size: 0.9rem !important;
    }

    .textbox,
    .textbox p {
        font-size: 1rem !important;
    }

    .choice {
        max-height: 220px !important;

        padding: 8px 8px 8px 8px !important;
    }

    .choice a,
    .choice a.link-internal,
    .choice .macro-link,
    #passages .passage a.link-internal,
    #passages .passage a.macro-link,
    #passages .passage button {
        width: 240px !important;
        max-width: calc(100vw - 80px) !important;

        font-size: 0.9rem !important;

        padding: 11px 22px !important;
    }
}