:: StoryStylesheet [stylesheet]


body {
  background: #070a0f;
  color: #c8d8e8;
  font-family: 'Georgia', serif;
  font-size: 17px;
  line-height: 1.85;
}

#ui-bar { display: none; }

#passages {
  max-width: 740px;
  margin: 0 auto;
  padding: 60px 30px 80px;
}

.passage {
  animation: fadeIn 0.7s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

a.link-internal {
  color: #e8a040;
  text-decoration: none;
  border-bottom: 1px solid rgba(232,160,64,0.3);
  padding-bottom: 1px;
  transition: border-color 0.2s, color 0.2s;
}

a.link-internal:hover {
  color: #f0b860;
  border-color: rgba(232,160,64,0.8);
}

.narrator {
  color: #c8d8e8;
  font-style: italic;
  border-left: 2px solid rgba(232,160,64,0.4);
  padding: 12px 0 12px 20px;
  margin: 20px 0;
  line-height: 1.9;
}

.alien {
  color: #4ab8a0;
  font-style: normal;
  border-left: 2px solid rgba(74,184,160,0.4);
  padding: 12px 0 12px 20px;
  margin: 20px 0;
  line-height: 1.9;
}

.exception {
  color: #c87868;
  font-style: normal;
  border-left: 2px solid rgba(200,120,104,0.4);
  padding: 12px 0 12px 20px;
  margin: 20px 0;
  line-height: 1.9;
}

.stage {
  color: #506070;
  font-size: 14px;
  font-style: italic;
  margin: 16px 0;
}

.choices {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.rule {
  border: none;
  border-top: 1px solid rgba(120,160,220,0.12);
  margin: 32px 0;
}

.title-screen {
  text-align: center;
  padding-top: 80px;
}

.title-screen h1 {
  font-family: 'Georgia', serif;
  font-size: 72px;
  font-weight: normal;
  color: #dce8f0;
  letter-spacing: 0.2em;
  margin-bottom: 12px;
  text-shadow: 0 0 60px rgba(232,160,64,0.15);
}

.title-screen .subtitle {
  font-size: 13px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #404f5a;
  margin-bottom: 60px;
}

.title-screen a.link-internal {
  font-size: 14px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.tracking {
  position: fixed;
  top: 20px;
  right: 20px;
  font-size: 11px;
  color: #304050;
  letter-spacing: 0.1em;
  line-height: 1.8;
  text-align: right;
}

